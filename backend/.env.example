MONGO_URI=
FASTAPI_URL=http://localhost:8000
NODE_ENV=development
PORT=5000
API_KEYS=
PROXY_TARGET=
UPSTREAM_ALLOWLIST=
CORS_ORIGINS=
FASTAPI_TIMEOUT_MS=750
PROXY_REQUEST_TIMEOUT_MS=5000
FAIL_CLOSED_ON_DETECTOR_ERROR=false
BODY_LIMIT=1mb

# Dashboard / Admin
ADMIN_USERNAME=admin
# Set a secure password here. Do NOT commit real secrets to git.
ADMIN_PASSWORD=admin123
ADMIN_ROLE=owner
DASHBOARD_TOKEN_SECRET=change-this-secret
DASHBOARD_TOKEN_TTL_SECONDS=28800

# Email (used for alerts)
EMAIL_USER=
EMAIL_PASS=
ALERT_EMAIL_RECIPIENT=

# FastAPI internal token (shared secret between services)
FASTAPI_INTERNAL_TOKEN=

# Optional feature flags
SHADOW_MODE=false
DEFAULT_BLOCK_THRESHOLD=0.75
DEFAULT_ALERT_THRESHOLD=0.5
DEFAULT_OVERRIDE_THRESHOLD=0.9

# Notes:
# - Copy this file to backend/.env and fill values.
# - Keep secrets out of version control. Use a secret manager for production.
